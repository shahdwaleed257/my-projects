    {
      "parameters": {
        "jsCode": "const items = [];\n\nfor (const item of $input.all()) {\n  let raw = item.json.output;\n\n  if (typeof raw === 'string') {\n    raw = raw.replace(/```json|```/g, '').trim();\n  }\n\n  let parsed;\n  try {\n    // المحاولة العادية الأولى\n    parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\n  } catch (e) {\n    // لو فشلت: يبقى عندنا كذا JSON object ملزوقين من غير array\n    // نحاول نستخرجهم بالـ regex\n    const matches = raw.match(/\\{[\\s\\S]*?\\}(?=\\s*\\{|\\s*$)/g);\n    if (matches) {\n      parsed = matches.map(m => JSON.parse(m));\n    } else {\n      throw new Error('Could not parse output: ' + raw.substring(0, 200));\n    }\n  }\n\n  const arr = Array.isArray(parsed) ? parsed : [parsed];\n  for (const analysis of arr) {\n    items.push({ json: { analysis } });\n  }\n}\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
