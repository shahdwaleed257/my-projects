    {
      "parameters": {
        "jsCode": "let parsedData = {};\nlet isJson = false;\nlet output = $json.output || \"\"; // جلب الرد أو اعتباره فارغاً\n\n// 1. التحقق إذا كان الرد فارغاً تماماً\nif (output.trim() === \"\") {\n  parsedData = { \n    ai_response: \"عذراً، لم أفهم طلبك، هل يمكنك التوضيح؟\" \n  };\n  isJson = false;\n} else {\n  try {\n    // 2. محاولة استخراج JSON من الرد\n    const jsonMatch = output.match(/\\{[\\s\\S]*\\}/);\n    \n    if (jsonMatch) {\n      parsedData = JSON.parse(jsonMatch[0]);\n      isJson = true;\n      parsedData.ai_response = output;\n    } else {\n      // 3. إذا كان الرد نصاً عادياً وليس JSON\n      parsedData = { ai_response: output };\n      isJson = false;\n    }\n  } catch (e) {\n    // 4. في حالة حدوث أي خطأ تقني في التحليل\n    parsedData = { ai_response: \"عذراً، حدث خطأ بسيط، هل يمكنك إعادة إرسال طلبك؟\" };\n    isJson = false;\n  }\n}\n\nparsedData.isJson = isJson;\nreturn [{ json: parsedData }];\n"
      },
      "id": "bdc57b1d-3d07-4437-8b35-af41334b0d5e",
      "name": "Parse AI Output5",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1376,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "const stockData = $node[\"Search records5\"].json.fields;\nconst aiData = $node[\"Parse AI Output5\"].json;\n\n// 1. لو المنتج مش موجود أصلاً في قاعدة البيانات\nif (!stockData || Object.keys(stockData).length === 0) {\n  return [{\n    json: {\n      status: \"not_found\",\n      product_name: aiData.item\n    }\n  }];\n}\n\nconst currentStock = parseInt(stockData.quantity) || 0;\n\n// 2. حالة الاستفسار عن السعر (Price Inquiry)\nif (aiData.action === \"check_price\") {\n  return [{\n    json: {\n      status: \"price_reply\",\n      product_name: stockData.product_name,\n      price: stockData.Price\n    }\n  }];\n}\n\n// 3. حالة الاستفسار عن التوفر (Stock Inquiry)\nif (aiData.action === \"check_stock\") {\n  return [{\n    json: {\n      status: \"inquiry_reply\",\n      product_name: stockData.product_name,\n      available_qty: currentStock\n    }\n  }];\n}\n\n// 4. حالة طلب الشراء (Order)\nconst requestedQty = parseInt(aiData.quantity) || 1;\n\nif (currentStock >= requestedQty) {\n  return [{\n    json: {\n      status: \"success\",\n      newStock: currentStock - requestedQty,\n      product_name: stockData.product_name,\n      rowId: $node[\"Search records5\"].json.id,\n      customer: aiData.customer_name,\n      phone: aiData.phone,\n      address: aiData.address\n    }\n  }];\n} else {\n  return [{\n    json: {\n      status: \"out_of_stock\",\n      available_qty: currentStock\n    }\n  }];\n}"
      },
