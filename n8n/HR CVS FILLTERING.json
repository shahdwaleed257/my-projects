        "jsCode": "const pdfData = $input.first().json;\nconst prevData = $('Extract Form Data').item.json;\n\nreturn [{\n  json: {\n    name: prevData.name,\n    email: prevData.email,\n    phone: prevData.phone,\n    jobTitle: prevData.jobTitle,\n    cvText: pdfData.text || ''\n  }\n}];"
      },
