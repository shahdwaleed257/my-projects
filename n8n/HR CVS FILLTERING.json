    {
      "parameters": {
        "jsCode": "const cvData = $('Combine CV Data').item.json;\nconst jobData = $input.first().json;\n\nif (!jobData || !jobData.job_description) {\n  throw new Error(`No job found for title: ${cvData.jobTitle}`);\n}\n\nreturn [{\n  json: {\n    name: cvData.name,\n    email: cvData.email,\n    phone: cvData.phone,\n    jobTitle: cvData.jobTitle,\n    cvText: cvData.cvText,\n    jobDescription: jobData.job_description,\n    requiredSkills: jobData.required_skills,\n    minExperience: jobData.min_experience,\n    passingScore: jobData.passing_score,\n    scoringNotes: jobData.scoring_notes\n  }\n}];"
      },
      "id": "0d40c47e-9ad2-4c0b-8f58-5716d5b57cda",
      "name": "Merge CV with Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert HR specialist and CV analyst.\n\nYour job is to carefully read the CV and compare it against the Job Description, then score the candidate objectively.\n\nJob Title: {{ $json.jobTitle }}\n\nJob Description:\n{{ $json.jobDescription }}\n\nRequired Skills:\n{{ $json.requiredSkills }}\n\nMinimum Experience Required: {{ $json.minExperience }} years\n\nPassing Score: {{ $json.passingScore }}\n\nScoring Notes:\n{{ $json.scoringNotes }}\n\nCV Text:\n{{ $json.cvText }}\n\n---\n\nReturn ONLY a valid JSON object, no extra text, no markdown backticks:\n\n{\n  \"name\": \"candidate full name\",\n  \"email\": \"candidate email\",\n  \"phone\": \"candidate phone number\",\n  \"job_title\": \"job title they applied for\",\n  \"years_experience\": 0,\n  \"matched_skills\": [\"skill1\", \"skill2\"],\n  \"missing_skills\": [\"skill1\", \"skill2\"],\n  \"score\": 0,\n  \"recommendation\": \"accept/reject/maybe\",\n  \"reason\": \"brief explanation of the score and recommendation\"\n}\n\nScoring criteria:\n- Skills match: 40%\n- Years of experience: 30%\n- Education relevance: 20%\n- Overall CV quality: 10%\n\nIf score is above passing score recommend accept, otherwise recommend reject."
      },
      "id": "c035bc25-be0a-4692-b5ab-2baa7e2d60a9",
      "name": "AI CV Analyzer",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        1440,
        0
      ]
    },
    {
      "parameters": {
