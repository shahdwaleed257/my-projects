    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a data transformation engine.\n\nYou will receive a JSON ARRAY as input.\n\nTransform EACH object into a Zoho CRM Lead–ready object and return ALL results as ONE JSON ARRAY.\n\nTRANSFORMATION RULES:\n- full_name: original name\n- first_name: first word of name\n- last_name: last word of name\n- email: original email\n- phone: original phone\n- city: address.city\n- Company: company.name (STRING ONLY)\n- website: original website\n- lead_source: \"AI Automation\"\n\nINPUT DATA:\n{{ JSON.stringify($input.all().map(i => i.json)) }}\n\nCRITICAL RULES:\n- company MUST be a STRING, not an object.\n- Process ALL items.\n- Do NOT skip any item.\n- Return ONLY a valid JSON ARRAY.\n- No text, no explanations, no markdown.\n",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "The data is provided inside the \"text\" field. Extract all items and convert them into a unified JSON array containing the fields listed above. Do not include any extra text, explanations, or repetitions."
            }
          ]
        },
        "batching": {}
      },
