    {
      "parameters": {
        "jsCode": "const inputData = $input.all();\nconst parsedItems = [];\n\nfor (const item of inputData) {\n  let textData = item.json.text;\n  \n  if (textData) {\n    try {\n      // Remove markdown code blocks\n      textData = textData.replace(/```[\\s\\S]*?```/g, (match) => {\n        return match.replace(/```json|```/g, '');\n      });\n\n      // Extract JSON part\n      const jsonMatch = textData.match(/[\\[\\{][\\s\\S]*[\\]\\}]/);\n      \n      if (jsonMatch) {\n        textData = jsonMatch[0];\n      }\n\n      textData = textData.trim();\n\n      const parsed = JSON.parse(textData);\n      \n      if (Array.isArray(parsed)) {\n        for (const entry of parsed) {\n          parsedItems.push({ json: entry });\n        }\n      } else if (typeof parsed === 'object' && parsed !== null) {\n        parsedItems.push({ json: parsed });\n      }\n\n    } catch (error) {\n      console.log('Failed to parse JSON:', error.message);\n    }\n  }\n}\n\n// fallback\nif (parsedItems.length === 0) {\n  return [{ json: { error: \"No data parsed\" } }];\n}\n\nreturn parsedItems;"
      },
