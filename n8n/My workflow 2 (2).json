      "parameters": {
        "jsCode": "// Assume input items are coming from previous node\n// Each item has a customer object in json\nconst inputItems = items; // n8n provides \"items\" automatically\n\n// Extract customer data from all items\nconst customersArray = inputItems.map(item => item.json);\n\n// Combine into a single JSON object\nconst output = {\n  customers: customersArray\n};\n\n// Return as a single item\nreturn [{ json: output }];\n"
