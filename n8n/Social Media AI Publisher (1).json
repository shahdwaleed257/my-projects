    {
      "parameters": {
        "jsCode": " const items = $input.all();\nconst vars = $('Set Variables').first().json;\nconst parsed = $('Parse AI Output').first().json;\n\nconst platforms = items.map(item => {\n  const data = item.json;\n  if (data.error) return 'Failed';\n  return 'Success';\n}).join(', ');\n\nreturn [{\n  json: {\n    date: vars.today,\n    content: parsed.full_post,\n    status: items.some(i => i.json.error) ? 'Partial' : 'Published',\n    platforms: 'Facebook, Instagram, Discord, Telegram, Twitter',\n    image_url: parsed.image_url || '',\n    error_log: items.filter(i => i.json.error).map(i => JSON.stringify(i.json.error)).join(' | ')\n  }\n}];"
      },
