      "parameters": {
        "jsCode": "const content = $input.first().json;\nconst raw = content.message?.content || content.choices?.[0]?.message?.content || '';\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch(e) {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  parsed = match ? JSON.parse(match[0]) : {\n    full_post: raw.slice(0, 200),\n    tweet: raw.slice(0, 250),\n    title: 'Daily Post',\n    description: raw.slice(0, 150)\n  };\n}\nconst vars = $('Set Variables').first().json;\nreturn [{ json: {\n  full_post: parsed.full_post || '',\n  tweet: parsed.tweet || parsed.full_post || '',\n  title: parsed.title || '',\n  description: parsed.description || '',\n  image_url: vars.image_url,\n  today: vars.today,\n  brand: vars.brand\n}}];"
      },
