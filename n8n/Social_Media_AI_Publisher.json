    {
      "parameters": {
        "jsCode": "const raw = String(\n  $input.first().json.candidates?.[0]?.content?.parts?.[0]?.text || \n  $input.first().json.text || \n  $input.first().json.content || ''\n);\n\nconst cleaned = raw\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .replace(/\\\\n/g, '')\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch(e) {\n  const match = cleaned.match(/\\{[\\s\\S]*\\}/);\n  parsed = match ? JSON.parse(match[0]) : {\n    full_post: cleaned,\n    tweet: cleaned,\n    title: 'AI Post',\n    description: cleaned\n  };\n}\n\nconst vars = $('Set Variables').first().json;\n\nreturn [{\n  json: {\n    full_post: parsed.full_post || '',\n    tweet: parsed.tweet || parsed.full_post || '',\n    title: parsed.title || '',\n    description: parsed.description || '',\n    today: vars.today,\n    brand: vars.brand,\n    image_url: vars.image_url\n  }\n}];"
      },
