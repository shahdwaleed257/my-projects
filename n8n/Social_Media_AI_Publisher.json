    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// 1. جلب التاريخ الحالي\nconst today = new Date().toISOString().split('T')[0];\n\n// 2. استخراج الـ content الحقيقي من المسار المعقد اللي في الصورة\nlet postContent = 'لم يتم توليد نص';\ntry {\n  // بنجيب النص الطويل اللي طالع من Message a model\n  const rawText = $('Message a model').first().json.content.parts[0].text;\n  \n  // بنحول النص لـ JSON حقيقي عشان نقدر ناخد منه full_post\n  const parsedData = JSON.parse(rawText);\n  postContent = parsedData.full_post || parsedData.text || rawText;\n} catch (e) {\n  // لو حصل أي خطأ في التحويل، بياخد النص الخام كاحتياط\n  try {\n    postContent = $('Message a model').first().json.content.parts[0].text;\n  } catch(err) {\n    postContent = 'لم يتم توليد نص';\n  }\n}\n\n// 3. تحديد المنصات الناجحة (بناءً على النودز اللي اشتغلت)\nconst successfulPlatforms = [];\nitems.forEach(item => {\n  const data = item.json;\n  if (!data.error) {\n    if (data.platform) successfulPlatforms.push(data.platform);\n    else if (data.url && data.url.includes('facebook')) successfulPlatforms.push('Facebook');\n    else if (data.url && data.url.includes('telegram')) successfulPlatforms.push('Telegram');\n    else if (data.url && data.url.includes('discord')) successfulPlatforms.push('Discord');\n  }\n});\n\nconst platformsList = successfulPlatforms.length > 0 \n  ? successfulPlatforms.join(', ') \n  : 'Facebook, Instagram, Discord, Telegram';\n\n// 4. تحديد الحالة\nconst hasError = items.some(i => i.json.error || i.json.status === 'failed');\nconst status = hasError ? 'Partial' : 'Published';\n\nreturn [{\n  json: {\n    Date: today,\n    Content: postContent,\n    Status: status,\n    Platforms: platformsList\n  }\n}];"
      },
