    {
      "parameters": {
        "jsCode": "const formData = $input.first().json;\n\nconst name = formData['Full Name'] || '';\nconst email = formData['Email'] || '';\nconst phone = formData['Phone Number'] || '';\nconst jobTitle = formData['Job Title'] || '';\n\n// Get the CV binary file\nconst cvBinary = $input.first().binary?.['Upload_CV'];\n\nif (!cvBinary) {\n  throw new Error('No CV file uploaded!');\n}\n\nreturn [{\n  json: {\n    name,\n    email,\n    phone,\n    jobTitle\n  },\n  binary: {\n    cv: cvBinary\n  }\n}];"
      },
