    {
      "parameters": {
        "jsCode": "const response = $input.first().json.text || $input.first().json.output || '';\n\nlet parsed;\ntry {\n  const clean = response.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(clean);\n} catch(e) {\n  throw new Error('Failed to parse AI response: ' + response);\n}\n\nconst cvData = $('Merge CV with Job').item.json;\n\nreturn [{\n  json: {\n    name: parsed.name || cvData.name,\n    email: parsed.email || cvData.email,\n    phone: parsed.phone || cvData.phone,\n    job_title: parsed.job_title || cvData.jobTitle,\n    years_experience: parsed.years_experience || 0,\n    matched_skills: Array.isArray(parsed.matched_skills) ? parsed.matched_skills.join(', ') : '',\n    missing_skills: Array.isArray(parsed.missing_skills) ? parsed.missing_skills.join(', ') : '',\n    score: parsed.score || 0,\n    recommendation: parsed.recommendation || 'reject',\n    reason: parsed.reason || '',\n    submitted_at: new Date().toISOString()\n  }\n}];"
      },
